# Broomba — environment variables
# Copy to .env.local and fill in values before running Phase 2

# Anthropic API key — required for Phase 2 (real AI analysis)
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by /api/analyze
ANTHROPIC_MODEL=claude-sonnet-4-6

# Use mock for load testing so tests do not spend AI budget
ANALYSIS_PROVIDER=claude
MOCK_ANALYSIS_DELAY_MS=25

# Optional load-test/rate-limit overrides
BROOMBA_DAILY_SCAN_LIMIT=16
BROOMBA_QUOTA_WINDOW_MS=86400000
BROOMBA_BURST_LIMIT=8
BROOMBA_BURST_WINDOW_MS=60000

# Optional shared limiter store. Recommended before testing multiple server
# instances or launch-like traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
